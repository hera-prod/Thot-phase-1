{
  "name": "thot-phase-1",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/start-electron.mjs --dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node scripts/start-electron.mjs",
    "test:electron": "node --test tests/electron/",
    "dist": "npm run build && electron-builder --linux AppImage --x64",
    "dev:preflight": "node scripts/dev-preflight.mjs",
    "depot:verifier": "THOT_PORTABLE=1 python3 -m backend.services.depot_integrite",
    "depot:reparer": "THOT_PORTABLE=1 python3 -m backend.services.depot_integrite --reparer",
    "depot:gc": "THOT_PORTABLE=1 python3 -m backend.services.depot_integrite --gc"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.18.1"
  }
}
